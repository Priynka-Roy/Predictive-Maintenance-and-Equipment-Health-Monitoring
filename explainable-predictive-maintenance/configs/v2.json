    "stability_weight": 0.05,
    "note": "Development-only workload objective: abs(issued_fraction-target)/target + 0.05*weekly_fraction_sd/target + 0.10*unannotated_burden/budget + complexity_penalty*model_complexity, minus at most 0.05 for detecting the one development event. Silent issued-alert policies are ineligible. If no global policy is feasible, stop the workflow. Per-model comparison may retain an ineligible policy explicitly marked as such. No benchmark metrics are supplied to selection.",
    "minimum_issued_alert_fraction": 0.001
  }
}
