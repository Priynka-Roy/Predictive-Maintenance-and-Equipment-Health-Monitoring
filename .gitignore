.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
.DS_Store
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
.streamlit/secrets.toml
.env
*.log

# Preserve the user’s nested project layout without publishing large originals.
**/data/raw/*
**/data/processed/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep
**/.env
**/.streamlit/secrets.toml
